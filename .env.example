# aistudio-api 环境变量配置
# 复制此文件为 .env 并按需修改

# ========== 服务基础配置 ==========
# HTTP 服务监听端口
AISTUDIO_PORT=8080
# Web 管理控制台访问密码（设置后访问 / 自动启用登录拦截）
AISTUDIO_WEB_PASSWORD=
# AISTUDIO_ADMIN_PASSWORD=
# 仅在可信内网明确开放全部接口时设置为 1（默认关闭）
AISTUDIO_ALLOW_NO_AUTH=0

# ========== API 调用鉴权 ==========
# 注入 API 调用鉴权 Key（/v1beta 路由），多个用逗号/换行分隔或 JSON 数组：
#   AISTUDIO_API_KEYS=sk-aaa,sk-bbb
#   AISTUDIO_API_KEYS=["sk-aaa","sk-bbb"]
# 亦可单数变量注入单个：AISTUDIO_API_KEY=sk-single
# 与 config.yaml 中面板创建的 Key 合并生效；无磁盘部署重启后自动恢复。
# 注意：未配置任何 API Key 时，Web 管理密码不会自动作为 API Key 使用；需配置 Key 才能调用 API。
AISTUDIO_API_KEYS=

# ========== 网络代理与凭据 ==========
# 出口代理，支持 http:// https:// socks5:// socks5h:// 与 TURN / TURNS / SSTP：
#   AISTUDIO_PROXY=http://127.0.0.1:7890
#   AISTUDIO_PROXY=socks5://user:pass@1.2.3.4:1080
#   AISTUDIO_PROXY=turn:turn.example.com:3478?transport=tcp   （RFC 7065 无斜线写法）
#   AISTUDIO_PROXY=turns://user:pass@host:5349?sni=cert.example.com
#   AISTUDIO_PROXY=sstp://user:pass@vpn.example.com:443?mtu=1280
# turn/turns/sstp 由内置桥接器转换为本地回环 SOCKS5（见下方桥接器配置）；
# 桥接失败直接报错，绝不静默降级直连（防真实 IP 泄漏）。
AISTUDIO_PROXY=
# TURN/SSTP 桥接器二进制路径（留空按顺序自动发现：仓库 proxybridge/bin/ →
# Docker 镜像内置 → PATH）。本地开发需先执行 bash proxybridge/build.sh 构建。
# AISTUDIO_PROXY_BRIDGE_BIN=
# TURN/SSTP 桥接实例空闲回收阈值（分钟，默认 30；0 = 不回收）
# AISTUDIO_PROXY_BRIDGE_IDLE_MINUTES=30
# 启动时注入的账号 Cookie（多条用换行分隔，亦可用字面 \n 或 JSON 字符串数组）。
# 单条格式三选一：代理+Cookie / 仅 Cookie / Cookie+代理，代理支持上述全部协议，例如：
#   socks5://127.0.0.1:1080+SID=xxx; HSID=yyy; __Secure-3PSID=zzz
#   turn:1.2.3.4:3478?transport=tcp+SID=xxx; HSID=yyy
#   SID=xxx; HSID=yyy
#   SID=xxx; HSID=yyy+http://10.0.0.1:7890
# 绑定独立代理的账号（请求 / Cookie 轮换 / 探活）全部走该代理出口。
AISTUDIO_COOKIES=
# 编号变量注入（与 AISTUDIO_COOKIES 可同时使用，适合无法传入多行环境变量的平台）
# AISTUDIO_COOKIES_1=
# AISTUDIO_COOKIES_2=
# Cookie 注入文件路径（内容格式与 AISTUDIO_COOKIES 相同，适合超长批量凭据）
AISTUDIO_COOKIES_FILE=
# 主数据持久化根目录（留空默认使用 data/）
AISTUDIO_DATA_DIR=
# 账号凭据存储目录（留空默认使用 data/accounts）
AISTUDIO_ACCOUNTS_DIR=
# 模型调用与 Token 使用量统计持久化文件（留空默认使用 data/stats.json）
AISTUDIO_STATS_FILE=
# 账号调度与 429 冷却状态持久化文件（留空默认使用 data/rotator_state.json）
AISTUDIO_ROTATOR_STATE_FILE=
# 自定义 config.yaml 配置文件路径（留空默认使用项目根目录 config.yaml）
AISTUDIO_CONFIG_FILE=
# 认证文件路径（可选，单文件调试或导入时覆盖使用）
AISTUDIO_AUTH_FILE=
# 是否持久化模型调用与 Token 统计（1=开启，0=关闭）
AISTUDIO_PERSIST_STATS=1
# 是否持久化账号调度与 429 冷却状态（1=开启，0=关闭）
AISTUDIO_PERSIST_ROTATOR=1
# 临时文件目录（留空自动获取系统临时目录）
AISTUDIO_TMP_DIR=
# WAA 证明签名服务地址（默认使用公开服务，支持自建 aistudio-pg-bridge）
AISTUDIO_PROOF_SERVER_URL=https://waa.spinsnow.fun

# ========== 浏览器跨域（CORS） ==========
# /v1/ 兼容接口允许的浏览器 Origin 白名单（逗号分隔，需精确匹配 scheme+host+port）。
# 出于安全默认留空：此时仅同源页面可用，且不会向任意站点回显凭据。
# 例：AISTUDIO_CORS_ALLOWED_ORIGINS=https://app.example.com,http://localhost:5173
# 注意：服务端到服务端调用不受此限制（不带 Origin 的请求始终可用）。
AISTUDIO_CORS_ALLOWED_ORIGINS=

# ========== 账号导入目录白名单 ==========
# POST /api/accounts/import-bundle 的 file_path 只允许读取 data/ 目录下的 .json。
# 需要从其它目录导入时，在此登记允许的根目录（Windows 用 ; 分隔，其余用 :）。
# 例：AISTUDIO_IMPORT_ROOTS=D:\backup\aistudio;/sdcard/Download
AISTUDIO_IMPORT_ROOTS=

# ========== 模型默认行为 ==========
AISTUDIO_DEFAULT_TEXT_MODEL=gemini-3.7-flash

# ========== 抗截断传输 ==========
# 强制覆盖 config.yaml 中 anti_truncation.enabled 全局开关
# （1/true/on 开启，0/false/off 关闭；留空跟随 config.yaml）
# 单次请求亦可用请求头 X-Anti-Truncation: 1 / 0 按需覆盖
AISTUDIO_ANTI_TRUNCATION=

# ========== 调试与报文转储 ==========
# 是否在终端转储每次 API 请求与响应报文详情（1=开启，0=关闭，亦支持 DEBUG=1）
AISTUDIO_DUMP_REQUESTS=0
# 是否将请求与响应转储持久化保存为独立文件（1=开启，0=关闭）
AISTUDIO_DUMP_FILE=0
# 转储文件保存目录（留空默认使用 data/dumps/）
AISTUDIO_DUMP_DIR=
# 可选：请求历史元数据持久化（不保存请求或响应正文）
AISTUDIO_REQUEST_HISTORY=1
AISTUDIO_HISTORY_DAYS=14
AISTUDIO_HISTORY_MAX_ROWS=100000
# 请求体总大小上限、并发请求上限、单次请求总超时（秒）
AISTUDIO_MAX_REQUEST_BYTES=33554432
AISTUDIO_MAX_CONCURRENT_REQUESTS=50
AISTUDIO_REQUEST_TIMEOUT=600
# 详细报文转储限制：单个请求体/响应体、文件数、保留天数、总容量
AISTUDIO_DUMP_MAX_BYTES=1048576
AISTUDIO_DUMP_MAX_FILES=1000
AISTUDIO_DUMP_MAX_AGE_DAYS=7
AISTUDIO_DUMP_MAX_TOTAL_BYTES=268435456
# 跨网络连接自建签名器时，为指定节点配置共享密钥
# AISTUDIO_SIGNER_SECRET=
# AISTUDIO_SIGNER_SECRET_URL=https://signer.example.com

# ========== WAA 签名服务 ==========
# 强制指定激活的签名服务 id，覆盖 config.yaml 的 waa.active_server
# （例: remote_spinsnow 走远程签名器。适用于无持久磁盘的 PaaS 部署，
# 或 512MB 小内存实例跳过本地签名引擎进程以节省内存。留空跟随 config.yaml）
AISTUDIO_WAA_SERVER=
# WAA proof 复用缓存 TTL（秒，默认 0=关闭）。
# 2026-11 HAR + 代理实测：浏览器级 attestation（真机抓包 proof）可长期
# 重放；但远程签名服务（spinsnow / NodeVM 类）mint 的 proof 观测到单次
# 使用现象（同 proof 二次请求即 403），且 mint 质量有概率抖动。因此
# 默认关闭；仅本地 SpiderMonkey 签名器等浏览器级 attestation 场景可
# 按需开启（建议先小 TTL 实测）。403 重签路径会自动失效缓存。
AISTUDIO_WAA_PROOF_CACHE_TTL=0

# RPC 请求 Accept-Language（默认 zh-CN,zh;q=0.9，与 2026-11 抓包一致）。
# Fetch Metadata 头（Sec-Fetch-* / Accept / Accept-Language）由
# build_makersuite_headers 自动携带；此变量仅覆盖语言值。
AISTUDIO_ACCEPT_LANGUAGE=zh-CN,zh;q=0.9

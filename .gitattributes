# 统一换行：git 内部一律 LF 存储，避免 Windows core.autocrlf=true 把
# #!/bin/sh / build.sh 写成 CRLF 导致容器 "bad interpreter: /bin/sh^M"。
* text=auto

# 脚本/代码/配置在工作区也强制 LF（shell 脚本尤其关键）
*.sh    text eol=lf
*.py    text eol=lf
*.ts    text eol=lf
*.tsx   text eol=lf
*.vue   text eol=lf
*.js    text eol=lf
*.mjs   text eol=lf
*.css   text eol=lf
*.json  text eol=lf
*.yaml  text eol=lf
*.yml   text eol=lf
*.toml  text eol=lf
*.md    text eol=lf
Dockerfile text eol=lf

# 二进制文件不做换行转换
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.ico   binary
*.webp  binary
*.woff  binary
*.woff2 binary
*.ttf   binary
*.jar   binary
*.so    binary
*.a     binary
*.xz    binary
*.gz    binary
